#!/usr/bin/env sh
# JadeCode 启动脚本:运行时只为本项目使用 JDK 21,不改系统默认(Java 8)。
# 用法: ./jade repl   |   ./jade run "任务"   |   ./jade --version

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JAVA_HOME="${JAVA21_HOME:-/usr/lib/jvm/java-21-openjdk-amd64}"
export JAVA_HOME

JAR="$DIR/target/jadecode.jar"
if [ ! -f "$JAR" ]; then
  echo "找不到 $JAR — 先构建: mvn -q package" >&2
  exit 1
fi

# 行编辑、历史和后台日志重画由 Java 内的 JLine 统一处理，不再外套 rlwrap 抢同一输入行。
exec "$JAVA_HOME/bin/java" -jar "$JAR" "$@"
