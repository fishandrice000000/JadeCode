#!/usr/bin/env sh
# Node 是全部客户端命令的唯一入口；脚本以 exec 替换自身，不保留转发进程。
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v "${JADE_NODE:-node}" >/dev/null 2>&1; then
  echo 'JadeCode requires Node >=22.19.0 for all client modes' >&2
  exit 2
fi
if [ ! -f "$DIR/target/frontend/dist/main.js" ]; then
  echo 'Build the complete distribution: node scripts/build-release.mjs' >&2
  exit 2
fi
exec "${JADE_NODE:-node}" "$DIR/target/frontend/dist/main.js" "$@"
