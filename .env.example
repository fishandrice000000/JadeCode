# JadeCode 配置 — 复制为 .env 后填入真实值
# 沿用课程环境变量命名:Anthropic 协议格式 + 可配置 base URL

# DeepSeek API key(https://platform.deepseek.com 获取)
ANTHROPIC_API_KEY=

# DeepSeek 的 Anthropic 兼容端点(已实测跑通课程 s01)
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 默认模型
MODEL_ID=deepseek-v4-flash

# 备用模型(529 连续失败时切换,s15 起使用)
# FALLBACK_MODEL_ID=

# 正式请求最大输出 token:auto 跟随已知模型上限;未知时回退 8000
# 可改成正整数限制输出;摘要、Memory 与辅助审批仍使用各自预算
MAX_TOKENS=auto
