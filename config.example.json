{
  "version": 1,
  "sandbox": {
    "enabled": true,
    "image": "jadecode-sandbox:1",
    "memoryMiB": 2048,
    "cpus": 2,
    "pids": 256,
    "tmpMiB": 256,
    "idleSeconds": 600,
    "maxIdle": 2,
    "maxContainers": 8
  },
  "tui": {
    "theme": "dark",
    "thinkingVisible": true,
    "toolsExpanded": false,
    "commandSuggestions": true
  },
  "memory": {
    "enabled": true,
    "recallMaxOutputTokens": 2048,
    "extractionMaxOutputTokens": 8000,
    "consolidationMaxOutputTokens": 16384,
    "consolidationInputChars": 128000,
    "extractionCatalogChars": 128000
  },
  "thinking": {
    "effort": "default"
  },
  "modelMetadata": {
    "autoDiscover": true,
    "cacheTtlHours": 24,
    "timeoutMillis": 2000,
    "overrides": {}
  },
  "compaction": {
    "autoSummaryEnabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000,
    "summaryMaxOutputTokens": 32768,
    "summaryMaxInputTokens": "auto",
    "largeResultCharLimit": 50000,
    "largeResultPreviewChars": 2000
  }
}
