{
  "version": 1,
  "mcp": {
    "servers": {
      "fetch": {
        "enabled": true,
        "command": ".jadecode/mcp/fetch/bin/python",
        "args": ["-m", "mcp_server_fetch"],
        "cwd": "",
        "startupTimeoutSeconds": 15,
        "callTimeoutSeconds": 30,
        "maxResultChars": 20000,
        "readOnlyTools": ["fetch"]
      }
    }
  },
  "tui": {
    "theme": "dark",
    "thinkingVisible": true,
    "toolsExpanded": false,
    "commandSuggestions": true
  },
  "memory": {
    "enabled": true,
    "recallMaxOutputTokens": 2048,
    "extractionMaxOutputTokens": 8000,
    "consolidationMaxOutputTokens": 16384,
    "consolidationInputChars": 128000,
    "extractionCatalogChars": 128000
  },
  "thinking": {
    "effort": "default"
  },
  "modelMetadata": {
    "autoDiscover": true,
    "cacheTtlHours": 24,
    "timeoutMillis": 2000,
    "overrides": {}
  },
  "compaction": {
    "largeResultEnabled": true,
    "batchBudgetEnabled": false,
    "snipEnabled": false,
    "microEnabled": false,
    "fitEnabled": false,
    "autoSummaryEnabled": true,
    "reactiveEnabled": false,
    "limits": {
      "contextCharLimit": 300000,
      "toolResultBatchCharLimit": 200000,
      "largeResultCharLimit": 50000,
      "summaryInputCharLimit": 400000,
      "keepRecentResults": 5,
      "keepRecentMessages": 5,
      "microResultMinChars": 4000,
      "budgetPreviewChars": 2000,
      "fitPreviewChars": 2000,
      "summaryMaxOutputTokens": 8000,
      "snipMaxMessages": 200,
      "snipHeadMessages": 3,
      "targetRatio": 0.8
    }
  }
}
